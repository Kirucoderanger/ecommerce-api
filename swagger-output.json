    "/api/auth/token": {
  "post": {
    "tags": ["Auth"],
    "summary": "Obtain OAuth2 access token",
    "consumes": ["application/x-www-form-urlencoded"],
    "parameters": [
      {
        "name": "grant_type",
        "in": "formData",
        "required": true,
        "type": "string",
        "default": "password"
      },
      {
        "name": "username",
        "in": "formData",
        "required": true,
        "type": "string"
      },
      {
        "name": "password",
        "in": "formData",
        "required": true,
        "type": "string"
      }
    ],
    "responses": {
      "200": { "description": "Access token" },
      "400": { "description": "Invalid request" },
      "401": { "description": "Unauthorized" }
    }
  }
},

